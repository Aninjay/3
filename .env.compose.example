# Copy this file to .env and replace each placeholder before starting Compose.
POSTGRES_DB=cultural_committee
POSTGRES_USER=tapmi_app
POSTGRES_PASSWORD=replace-with-a-long-hex-value
SECRET_KEY=replace-with-a-random-secret
APP_PORT=5000
PILOT_EVENT_NAME=Kala Fest
CORS_ORIGINS=https://your-site-name.netlify.app

# Set both bootstrap values to create the first Convener account.
BOOTSTRAP_CONVENER_EMAIL=convener@tapmi.edu.in
BOOTSTRAP_CONVENER_PASSWORD=replace-with-a-unique-password-of-12-characters-or-more

# Keep false for production. true loads the public demo credentials and sample dataset.
SEED_DEMO_DATA=false
